generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  ADMIN
  MERCHANDISER
}

enum SalesOrderStatus {
  DRAFT // Converted from a Quotation, not yet confirmed — no merchandiser assigned yet
  CONFIRMED // Merchandiser assigned — ready to be delivered/invoiced, in one shot or partially
  DONE // Every line fully delivered
  CANCELLED
}

enum DeliveryStatus {
  PENDING // Created, not yet shipped
  SHIPPED // On the truck
  DELIVERED // Arrived, proof of delivery captured
  CANCELLED
}

enum ProductType {
  GOODS
  SERVICE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StockMovementType {
  TRANSFER
  WRITE_OFF
  ADJUSTMENT
  PURCHASE_RECEIPT
  RETURN_TO_SUPPLIER
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum RFQStatus {
  DRAFT
  SENT
  CLOSED
  CONVERTED
  CANCELLED
}

enum RFQResponseStatus {
  PENDING
  SELECTED
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  SALES_PAYMENT
  PURCHASE_INVOICE
  PURCHASE_RECEIPT
  PURCHASE_PAYMENT
  PARTY_PAYMENT
  EXPENSE_APPROVAL
  EXPENSE_PAYMENT
  POS_SALE
  POS_SALE_COGS
  SALES_DELIVERY_COGS
  SALES_DELIVERY_RETURN
  PURCHASE_RECEIPT_RETURN
  PAYROLL_RUN
  PAYROLL_DISBURSEMENT
  LOAN_ISSUANCE
  EOS_ACCRUAL
  STOCK_ADJUSTMENT
  RESTAURANT_TIP
  POS_SESSION_VARIANCE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  REJECTED
}

enum JournalType {
  SALE
  PURCHASE
  CASH
  BANK
  MISC
}

enum PaymentMethodType {
  CASH_BANK
  ACCOUNT_RECEIVABLE
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

enum EmployeeLoanStatus {
  ACTIVE
  CLOSED
}

// --- CORE TABLES ---
model User {
  id                    Int            @id @default(autoincrement())
  email                 String         @unique
  password              String
  name                  String?
  role                  Role           @default(MERCHANDISER)
  salesOrders           SalesOrder[] // A merchandiser can be assigned many sales orders
  quotations            Quotation[]
  employee              Employee?
  jobOrdersAsTechnician JobOrder[]
  leadsAssigned         Lead[]
  appointmentsAsStaff   Appointment[]
  tasksAssigned         Task[]         @relation("TaskAssignee")
  tasksCreated          Task[]         @relation("TaskCreator")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Warehouse {
  id             Int             @id @default(autoincrement())
  name           String
  location       String?
  inventories    Inventory[]
  salesOrders    SalesOrder[] // Sales orders fulfilled by this specific warehouse
  purchaseOrders PurchaseOrder[] // Purchase orders received into this warehouse
  quotations     Quotation[]
  rfqs           RFQ[]
  posSessions    PosSession[]
  jobOrders      JobOrder[]
  journalLines   JournalLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  // --- BARCODES & SKU ---
  sku        String? @unique
  barcodePcs String? @unique
  barcodeBox String? @unique

  name               String
  description        String?
  price              Float               @default(0)
  // Unit cost, used for COGS postings (POS sales). 0 means "not set yet" — no COGS posts until an admin fills this in.
  costPrice          Float               @default(0)
  // A Service skips warehouse/stock/batch requirements entirely on the Sales side (Delivery, POS)
  // — appropriate for labor/installation/fee line items with nothing to hold in a warehouse.
  type               ProductType         @default(GOODS)
  // Defaults true so no existing product silently disappears from the POS checkout grid.
  posActive          Boolean             @default(true)
  // General archive flag — distinct from posActive (which only controls POS checkout
  // visibility). An archived product drops out of catalog/creation pickers everywhere but
  // keeps every historical relation (orders, invoices, GL) intact; never hard-deleted.
  isActive           Boolean             @default(true)
  categoryId         Int?
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posCategoryId      Int?
  posCategory        PosCategory?        @relation(fields: [posCategoryId], references: [id], onDelete: SetNull)
  unitId             Int?
  unit               UnitOfMeasurement?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventories        Inventory[]
  salesOrderItems    SalesOrderItem[]
  deliveryItems      DeliveryItem[]
  invoiceItems       InvoiceItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       ReceiptItem[]
  billItems          BillItem[]
  quotationItems     QuotationItem[]
  rfqItems           RFQItem[]
  rfqResponseItems   RFQResponseItem[]
  posSaleItems       PosSaleItem[]
  jobOrderParts      JobOrderPart[]
}

model Inventory {
  id       Int @id @default(autoincrement())
  quantity Int @default(0)

  // --- NEW: BATCH & EXPIRY TRACKING ---
  batchNumber String    @default("DEFAULT")
  expiryDate  DateTime? // Optional, because some products (like hardware) don't expire

  // Actual landed cost for this specific batch (from PurchaseOrderItem.unitCost at receipt
  // time) — 0 means "not tracked yet" (pre-existing rows, or stock added outside a Receipt),
  // in which case valuation/COGS callers fall back to Product.costPrice. This is what lets
  // stock valuation and COGS reflect what was actually paid per batch instead of a single
  // mutable Product-level number that drifts once supplier prices change.
  unitCost Float @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW UNIQUE CONSTRAINT: A warehouse can have multiple of the same product, but not the same batch
  @@unique([productId, warehouseId, batchNumber])
}

// --- SALES: Quotation -> SalesOrder -> Delivery(s) -> Invoice(s) -> Payment ---
// A SalesOrder is the confirmed intent to sell — no stock movement, no billing yet.
// Delivery is the physical fulfillment (batch/expiry captured, stock deducted) — a SalesOrder
// can have several Deliveries (partial shipments). Invoice is the billing document (GL posts
// here) — a SalesOrder can have several Invoices (partial billing), independent of delivery
// progress (invoicing policy = against ordered quantity, matching Odoo's "Ordered Quantities").
model SalesOrder {
  id          Int              @id @default(autoincrement())
  status      SalesOrderStatus @default(DRAFT)
  // Sum of net line totals BEFORE the discountType/discountValue below is applied — the base
  // the global discount computes from. totalAmount stays what it already meant: the final total.
  subtotal    Float            @default(0)
  totalAmount Float            @default(0)

  // Global (whole-document) discount — 'PERCENT' or 'AMOUNT'. Null/0 = no discount.
  discountType  String?
  discountValue Float   @default(0)

  // Applied to (subtotal - discount), added on top — never baked into line prices like a
  // discount is, since tax is shown as its own line on every document/receipt.
  taxId     Int?
  tax       Tax?    @relation(fields: [taxId], references: [id])
  taxAmount Float   @default(0)

  termsAndConditions String?
  // Customer's own PO/reference number for this order — free text.
  customerReference  String?

  // Who's fulfilling this order? Null for a DRAFT order (converted from a Quotation, not yet confirmed).
  userId      Int?
  user        User?            @relation(fields: [userId], references: [id])
  clientName  String?
  // Optional link to the Customer directory — clientName stays the source of truth for
  // aging/ledger matching, this just remembers which saved customer it came from.
  customerId  Int?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Which warehouse is fulfilling this order?
  warehouseId Int
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  items       SalesOrderItem[]
  deliveries  Delivery[]
  invoices    Invoice[]

  // Set when this order was created by converting a Quotation
  quotation Quotation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  // Final NET unit price (after any line discount below) — everything downstream (Invoice, GL)
  // reads this field exactly as before; discount handling never leaves this service.
  price    Float

  // Original unit price before the line discount. Null = no line discount was applied, so
  // `price` IS the list price.
  listPrice         Float?
  lineDiscountType  String?
  lineDiscountValue Float   @default(0)

  // Running totals so partial deliveries/invoices know how much of this line remains.
  quantityDelivered Int @default(0)
  quantityInvoiced  Int @default(0)

  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  deliveryItems DeliveryItem[]
  invoiceItems  InvoiceItem[]
}

// --- DELIVERY: the physical shipment/fulfillment event ---
model Delivery {
  id           Int            @id @default(autoincrement())
  status       DeliveryStatus @default(PENDING)
  salesOrderId Int
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id])

  proofOfDelivery String?
  items           DeliveryItem[]
  returns         DeliveryReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryItem {
  id       Int @id @default(autoincrement())
  quantity Int

  // Record which exact batch was shipped
  batchNumber String    @default("DEFAULT")
  boxBarcode  String?
  expiryDate  DateTime?

  deliveryId Int
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  salesOrderItemId Int
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  returnItems DeliveryReturnItem[]
}

// A customer return against an already-shipped Delivery — restocks inventory and reverses the
// proportional COGS with a fresh entry (not a void of the original, since a return is often
// partial and the original COGS entry covers the whole delivery). Ledger-style: any number of
// returns can be logged against the same Delivery; "already returned" is always summed from
// this table, never a mutable counter on DeliveryItem.
model DeliveryReturn {
  id         Int                  @id @default(autoincrement())
  deliveryId Int
  delivery   Delivery             @relation(fields: [deliveryId], references: [id])
  reason     String?
  items      DeliveryReturnItem[]
  createdAt  DateTime             @default(now())
}

model DeliveryReturnItem {
  id               Int            @id @default(autoincrement())
  deliveryReturnId Int
  deliveryReturn   DeliveryReturn @relation(fields: [deliveryReturnId], references: [id], onDelete: Cascade)
  deliveryItemId   Int
  deliveryItem     DeliveryItem   @relation(fields: [deliveryItemId], references: [id])
  quantity         Int
}

// --- INVOICE: the billing document — this is where accounting posts ---
model Invoice {
  id            Int        @id @default(autoincrement())
  invoiceNumber String?    @unique
  salesOrderId  Int
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id])

  // Net line-item sum, before tax — totalAmount is subtotal + taxAmount (payment/balance logic
  // always reads totalAmount, unaffected by tax being broken out here).
  subtotal      Float         @default(0)
  taxId         Int?
  tax           Tax?          @relation(fields: [taxId], references: [id])
  taxAmount     Float         @default(0)
  totalAmount   Float
  paymentStatus PaymentStatus @default(UNPAID)
  amountPaid    Float         @default(0)
  // Resolved from the customer's default terms (or overridden) at creation time — dueDate is a
  // frozen snapshot (createdAt + term.days), never recomputed if the term is edited later.
  paymentTermId Int?
  paymentTerm   PaymentTerm?  @relation(fields: [paymentTermId], references: [id])
  dueDate       DateTime?
  items         InvoiceItem[]
  payments      Payment[]

  // Foreign-currency quote, frozen at creation time — totalAmount above is always the real,
  // posted QAR figure; these three fields are purely an informational overlay + the input the
  // FX Revaluation report needs. Null currencyId = QAR only (the overwhelming default case).
  currencyId         Int?
  currency           Currency? @relation(fields: [currencyId], references: [id])
  exchangeRate       Float? // units of QAR per 1 unit of currencyId, snapshotted at creation
  foreignTotalAmount Float? // totalAmount expressed in currencyId, i.e. totalAmount / exchangeRate

  // Set on cancel — every SALES_INVOICE/SALES_PAYMENT journal entry gets voided (reversal
  // entries posted) at the same time, same "timestamp + audit-safe" convention as PosSale.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  price    Float

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  salesOrderItemId Int
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Float
  method     String?
  journalId  Int?
  journal    Journal? @relation(fields: [journalId], references: [id])
  receivedAt DateTime @default(now())
}

model StockMovement {
  id              Int               @id @default(autoincrement())
  productId       Int
  batchNumber     String
  fromWarehouseId Int? // Null if it's a new stock adjustment
  toWarehouseId   Int? // Null if it's a write-off / damage
  quantity        Int // The amount moved
  type            StockMovementType
  reason          String? // e.g., "Damaged in transit", "Moved to Shop"
  createdAt       DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// --- PURCHASE ENGINE ---
model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  // Default credit terms — carried onto each new Bill for this supplier's PO, editable per-bill.
  paymentTermId  Int?
  paymentTerm    PaymentTerm?    @relation(fields: [paymentTermId], references: [id])
  purchaseOrders PurchaseOrder[]
  rfqResponses   RFQResponse[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// --- SALES: Customer directory (analogous to Supplier on the Purchase side) ---
model Customer {
  id                  Int                  @id @default(autoincrement())
  name                String
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  // Default credit terms — carried onto each new Invoice for this customer's order, editable per-invoice.
  paymentTermId       Int?
  paymentTerm         PaymentTerm?         @relation(fields: [paymentTermId], references: [id])
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  posSales            PosSale[]
  loyaltyTransactions LoyaltyTransaction[]
  vehicles            Vehicle[]
  jobOrders           JobOrder[]
  leadSource          Lead?
  appointments        Appointment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// --- APP STORE: CRM Leads, Appointments, Todo List (each installable independently) ---
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// Prospects, kept separate from the paying-customer Customer directory — a Lead becomes a
// Customer via an explicit "Convert" action once WON, never silently merged.
model Lead {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  source        String?
  stage         LeadStage @default(NEW)
  notes         String?

  assignedToId Int?
  assignedTo   User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // Set once this Lead is converted — the Lead row stays for history, it just points at the
  // Customer it became. A Lead can only ever convert once (unique).
  convertedCustomerId Int?      @unique
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Tied to a Customer or a Lead (or neither, for an internal-only appointment) — never both is
// enforced at the service layer, not the schema, same "trust the DTO" convention used elsewhere.
model Appointment {
  id            Int               @id @default(autoincrement())
  title         String
  appointmentAt DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  staffId Int?
  staff   User? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// A shared, assignable task board — any user can see and assign tasks to any other user, no
// per-user privacy concept (that's the "Personal per-user list" option this codebase did NOT take).
model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  assignedToId Int?
  assignedTo   User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- APP STORE: Vehicle Management + Job Order (both installable independently) ---
model Vehicle {
  id          Int        @id @default(autoincrement())
  plateNumber String     @unique
  make        String?
  model       String?
  year        Int?
  color       String?
  vin         String?
  customerId  Int?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes       String?
  jobOrders   JobOrder[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum JobOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model JobOrder {
  id              Int             @id @default(autoincrement())
  jobNumber       String          @unique
  status          JobOrderStatus  @default(OPEN)
  vehicleId       Int
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  // Snapshot of the vehicle's owner at creation time — same "store it, don't just infer it"
  // convention as PosSale.clientName next to customerId.
  customerId      Int?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  technicianId    Int?
  technician      User?           @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  warehouseId     Int
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  description     String?
  odometerReading Int?
  notes           String?
  partsTotal      Float           @default(0)
  laborTotal      Float           @default(0)
  totalAmount     Float           @default(0)
  parts           JobOrderPart[]
  laborLines      JobOrderLabor[]
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model JobOrderPart {
  id          Int      @id @default(autoincrement())
  jobOrderId  Int
  jobOrder    JobOrder @relation(fields: [jobOrderId], references: [id])
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  batchNumber String
  quantity    Int
  unitPrice   Float
  costPrice   Float
  createdAt   DateTime @default(now())
}

model JobOrderLabor {
  id          Int      @id @default(autoincrement())
  jobOrderId  Int
  jobOrder    JobOrder @relation(fields: [jobOrderId], references: [id])
  description String
  hours       Float?
  rate        Float?
  amount      Float
  createdAt   DateTime @default(now())
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

// Balance is never stored directly — same incremental-ledger convention as EOS gratuity accrual:
// always the sum of this table's `points` for a customer, never a mutable counter that can drift.
model LoyaltyTransaction {
  id         Int                    @id @default(autoincrement())
  customerId Int
  customer   Customer               @relation(fields: [customerId], references: [id])
  points     Int
  type       LoyaltyTransactionType
  note       String?
  sourceType String?
  sourceId   Int?
  createdAt  DateTime               @default(now())

  @@index([customerId])
}

// --- PURCHASE: RFQ -> PurchaseOrder -> Receipt(s) -> Bill(s) -> Payment ---
// A PurchaseOrder is the confirmed intent to buy — no stock movement, no billing yet.
// Receipt is the physical goods-receipt (batch/expiry captured, stock added) — a PurchaseOrder
// can have several Receipts (partial deliveries from the supplier). Bill is the billing document
// (GL posts here) — a PurchaseOrder can have several Bills (partial billing), independent of
// receipt progress (billing policy = against ordered quantity, matching the Sales side's Invoice).
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Float               @default(0)
  taxId       Int?
  tax         Tax?                @relation(fields: [taxId], references: [id])
  taxAmount   Float               @default(0)
  reference   String? // Supplier's own invoice/PO number

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  items    PurchaseOrderItem[]
  receipts Receipt[]
  bills    Bill[]

  // Set when this PO was created by converting a winning RFQ response
  rfqResponse RFQResponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id               Int   @id @default(autoincrement())
  quantityOrdered  Int
  // Running totals so partial receipts/bills know how much of this line remains.
  quantityReceived Int   @default(0)
  quantityBilled   Int   @default(0)
  unitCost         Float

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  receiptItems ReceiptItem[]
  billItems    BillItem[]
}

// --- RECEIPT: the physical goods-receipt event ---
model Receipt {
  id              Int           @id @default(autoincrement())
  receiptNumber   String?       @unique
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  items   ReceiptItem[]
  returns ReceiptReturn[]

  createdAt DateTime @default(now())
}

model ReceiptItem {
  id       Int @id @default(autoincrement())
  quantity Int

  // Record which exact batch was received
  batchNumber String    @default("DEFAULT")
  expiryDate  DateTime?

  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  returnItems ReceiptReturnItem[]
}

// A return-to-supplier against an already-received Receipt — de-stocks inventory (guarded, can't
// return more than is still on hand) and reverses the proportional Inventory/Stock-Interim entry
// with a fresh entry, same "new entry, not a void" reasoning as DeliveryReturn.
model ReceiptReturn {
  id        Int                 @id @default(autoincrement())
  receiptId Int
  receipt   Receipt             @relation(fields: [receiptId], references: [id])
  reason    String?
  items     ReceiptReturnItem[]
  createdAt DateTime            @default(now())
}

model ReceiptReturnItem {
  id              Int           @id @default(autoincrement())
  receiptReturnId Int
  receiptReturn   ReceiptReturn @relation(fields: [receiptReturnId], references: [id], onDelete: Cascade)
  receiptItemId   Int
  receiptItem     ReceiptItem   @relation(fields: [receiptItemId], references: [id])
  quantity        Int
}

// --- BILL: the billing document — this is where accounting posts ---
model Bill {
  id              Int           @id @default(autoincrement())
  billNumber      String?       @unique
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  subtotal      Float             @default(0)
  taxId         Int?
  tax           Tax?              @relation(fields: [taxId], references: [id])
  taxAmount     Float             @default(0)
  totalAmount   Float
  paymentStatus PaymentStatus     @default(UNPAID)
  amountPaid    Float             @default(0)
  paymentTermId Int?
  paymentTerm   PaymentTerm?      @relation(fields: [paymentTermId], references: [id])
  dueDate       DateTime?
  items         BillItem[]
  payments      PurchasePayment[]

  // Foreign-currency quote, frozen at creation time — see Invoice's identical fields for why.
  currencyId         Int?
  currency           Currency? @relation(fields: [currencyId], references: [id])
  exchangeRate       Float?
  foreignTotalAmount Float?

  // Set on cancel — every PURCHASE_INVOICE/PURCHASE_PAYMENT journal entry gets voided at the
  // same time (reversal entries posted), same convention as Invoice.cancelledAt.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  // Defaults to the PO's ordered unitCost, editable for real price variance vs. the actual supplier invoice.
  unitCost Float

  billId Int
  bill   Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model PurchasePayment {
  id        Int      @id @default(autoincrement())
  billId    Int
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Float
  method    String?
  journalId Int?
  journal   Journal? @relation(fields: [journalId], references: [id])
  paidAt    DateTime @default(now())
}

// --- QUOTATIONS (pre-sale, converts into an Order) ---
model Quotation {
  id          Int             @id @default(autoincrement())
  status      QuotationStatus @default(DRAFT)
  clientName  String?
  // Optional link to the Customer directory — clientName stays the source of truth for
  // aging/ledger matching, this just remembers which saved customer it came from.
  customerId  Int?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Sum of net line totals BEFORE the discountType/discountValue below is applied.
  subtotal    Float           @default(0)
  totalAmount Float           @default(0)
  validUntil  DateTime?

  // Global (whole-document) discount — 'PERCENT' or 'AMOUNT'. Null/0 = no discount.
  discountType  String?
  discountValue Float   @default(0)

  taxId     Int?
  tax       Tax?    @relation(fields: [taxId], references: [id])
  taxAmount Float   @default(0)

  termsAndConditions String?
  // Customer's own PO/reference number for this quotation — free text.
  customerReference  String?

  // Merchandiser is chosen later, when the converted draft order is confirmed — not here.
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  items QuotationItem[]

  // Set once this quotation is converted into a real Sales Order
  convertedOrderId Int?        @unique
  convertedOrder   SalesOrder? @relation(fields: [convertedOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuotationItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  // Final NET unit price (after any line discount below).
  price    Float

  // Original unit price before the line discount. Null = no line discount was applied.
  listPrice         Float?
  lineDiscountType  String?
  lineDiscountValue Float   @default(0)

  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// --- RFQs (multi-supplier comparison, converts into a PurchaseOrder) ---
model RFQ {
  id     Int       @id @default(autoincrement())
  status RFQStatus @default(DRAFT)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  items     RFQItem[]
  responses RFQResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RFQItem {
  id       Int @id @default(autoincrement())
  quantity Int

  rfqId Int
  rfq   RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model RFQResponse {
  id          Int               @id @default(autoincrement())
  status      RFQResponseStatus @default(PENDING)
  totalAmount Float             @default(0)

  rfqId Int
  rfq   RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items RFQResponseItem[]

  // Set once this response is picked and converted into a real PurchaseOrder
  convertedPurchaseOrderId Int?           @unique
  convertedPurchaseOrder   PurchaseOrder? @relation(fields: [convertedPurchaseOrderId], references: [id])

  createdAt DateTime @default(now())
}

model RFQResponseItem {
  id       Int   @id @default(autoincrement())
  unitCost Float

  rfqResponseId Int
  rfqResponse   RFQResponse @relation(fields: [rfqResponseId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// --- ACCOUNTING (double-entry, auto-posted from Sales/Purchase activity) ---
model Account {
  id                Int               @id @default(autoincrement())
  code              String            @unique
  name              String
  type              AccountType
  // Cosmetic grouping only (e.g. "Current Asset" / "Long-term Liability") — purely for COA display, never read by posting logic.
  subtype           String?
  isSystemAccount   Boolean           @default(false)
  // Deactivated accounts stay for historical journal lines but drop out of pickers for new entries.
  isActive          Boolean           @default(true)
  journalLines      JournalLine[]
  expenseCategories ExpenseCategory[]
  journalsAsDebit   Journal[]         @relation("JournalDebit")
  journalsAsCredit  Journal[]         @relation("JournalCredit")
  accountMappings   AccountMapping[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Every automatic GL posting site (deliveries, POS, invoices, payroll, stock adjustments, ...)
// resolves the account it posts to via one of these roles instead of a hardcoded CoA code, so an
// admin can remap the destination account per role from Settings without touching code.
enum AccountMappingRole {
  CASH_BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  STOCK_INTERIM
  COGS
  INVENTORY_ADJUSTMENT
  SALES_REVENUE
  EXPENSES_PAYABLE
  SALARY_EXPENSE
  GRSIA_EMPLOYER_EXPENSE
  GRSIA_PAYABLE
  EMPLOYEE_ADVANCES_RECEIVABLE
  SALARY_PAYABLE
  EOS_GRATUITY_EXPENSE
  EOS_GRATUITY_ACCRUAL
  TIPS_PAYABLE
  CASH_DIFFERENCE_GAIN
  CASH_DIFFERENCE_LOSS
  TAX_PAYABLE
  TAX_RECEIVABLE
}

// A single flat-rate tax (e.g. "VAT 5%") selectable on a sales/purchase document. Kept
// deliberately simple — one rate per Tax row, no compound/nested tax support — since nothing in
// this app's target markets needs tax-on-tax stacking.
model Tax {
  id        Int      @id @default(autoincrement())
  name      String
  rate      Float // percent, e.g. 5 for 5%
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  salesOrders    SalesOrder[]
  quotations     Quotation[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]
  posSales       PosSale[]
}

// Foreign currencies quotable on an Invoice/Bill on top of the base (QAR) figures — every dollar
// amount in this app is still computed and posted in QAR exactly as before; a Currency just
// freezes "at today's rate, this is worth X" for the customer's/supplier's reference and feeds
// the FX Revaluation report. No line-item pricing is ever denominated in a foreign currency.
model Currency {
  id                 Int      @id @default(autoincrement())
  code               String   @unique // e.g. USD, EUR, SAR
  name               String
  symbol             String?
  // Units of QAR per 1 unit of this currency — e.g. 3.64 for USD. Kept live/editable; each
  // Invoice/Bill freezes its own snapshot of this rate at creation time (see exchangeRate below).
  exchangeRateToBase Float
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  invoices Invoice[]
  bills    Bill[]
}

model AccountMapping {
  id        Int                @id @default(autoincrement())
  role      AccountMappingRole @unique
  accountId Int
  account   Account            @relation(fields: [accountId], references: [id])
  updatedAt DateTime           @updatedAt
}

// --- JOURNALS (Odoo-style: Cash/Bank/Sales/Purchase/Misc) — distinct from JournalEntry (the
// actual transaction record). Each journal optionally has a default debit/credit account, used
// to resolve which GL account a payment posts to when the user picks that journal.
model Journal {
  id                     Int               @id @default(autoincrement())
  name                   String
  code                   String            @unique
  type                   JournalType
  sequencePrefix         String
  defaultDebitAccountId  Int?
  defaultDebitAccount    Account?          @relation("JournalDebit", fields: [defaultDebitAccountId], references: [id])
  defaultCreditAccountId Int?
  defaultCreditAccount   Account?          @relation("JournalCredit", fields: [defaultCreditAccountId], references: [id])
  isActive               Boolean           @default(true)
  paymentMethods         PaymentMethod[]
  journalEntries         JournalEntry[]
  payments               Payment[]
  partyPayments          PartyPayment[]
  purchasePayments       PurchasePayment[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

// Data-driven payment method -> journal mapping, used by payment forms and POS checkout.
// CASH_BANK posts through the linked journal's default account; ACCOUNT_RECEIVABLE posts to AR
// (no journal needed — it's billed on credit).
model PaymentMethod {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  type      PaymentMethodType @default(CASH_BANK)
  journalId Int?
  journal   Journal?          @relation(fields: [journalId], references: [id])
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  posSales  PosSale[]
  posSalePayments PosSalePayment[]
}

// One row per tender on a sale — even a single-method sale gets exactly one row, so reporting
// and receipts never need to branch on "was this split-tender or not", they just read this array.
model PosSalePayment {
  id              Int           @id @default(autoincrement())
  posSaleId       Int
  posSale         PosSale       @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Float
  createdAt       DateTime      @default(now())
}

// --- GENERIC PAYMENTS (record one payment, allocate across multiple open sales invoices or purchase bills) ---
model PartyPayment {
  id            Int                      @id @default(autoincrement())
  // Nullable then filled right after create (same pattern as Order.invoiceNumber) — multiple
  // NULLs coexist fine under a unique constraint, avoiding a placeholder-value collision race.
  paymentNumber String?                  @unique
  partyType     PartyType
  partyName     String
  amount        Float
  method        String?
  journalId     Int?
  journal       Journal?                 @relation(fields: [journalId], references: [id])
  notes         String?
  allocations   PartyPaymentAllocation[]

  createdAt DateTime @default(now())
}

model PartyPaymentAllocation {
  id             Int          @id @default(autoincrement())
  partyPaymentId Int
  partyPayment   PartyPayment @relation(fields: [partyPaymentId], references: [id], onDelete: Cascade)

  // Loose reference (not a FK) since it points at either an Order or a PurchaseOrder — same
  // pattern already used by JournalEntry.sourceId.
  sourceType      String // 'SALES_INVOICE' | 'PURCHASE_INVOICE'
  sourceId        Int
  amountAllocated Float
}

// --- PRODUCT / POS CATEGORIES (two independent lists — a product's catalog grouping for
// reporting can differ from how it's grouped on the POS checkout screen) ---
model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model PosCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  // Controls tab/section order on the POS checkout screen.
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model UnitOfMeasurement {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  abbreviation String
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
}

// A customer's/supplier's default credit terms (e.g. "Net 30") — resolved onto Invoice/Bill at
// creation time to compute a real dueDate, instead of AR/AP aging just counting from createdAt.
model PaymentTerm {
  id        Int       @id @default(autoincrement())
  name      String // e.g. "Net 30", "Due on Receipt"
  days      Int // 0 = due immediately
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())

  customers Customer[]
  suppliers Supplier[]
  invoices  Invoice[]
  bills     Bill[]
}

// A department/project cost bucket an admin can tag onto a manual journal line or an expense —
// purely a reporting dimension on JournalLine, no effect on posting logic itself.
model CostCenter {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalLines JournalLine[]
  expenses     Expense[]
}

// A named accounting period (e.g. "FY2026") that can be LOCKED to freeze the ledger — once
// locked, no new/voided journal entry may post with a date inside it. Ranges may not overlap
// (enforced in the service, not the schema).
enum FiscalYearStatus {
  OPEN
  LOCKED
}

model FiscalYear {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  startDate DateTime
  endDate   DateTime
  status    FiscalYearStatus @default(OPEN)
  lockedAt  DateTime?
  createdAt DateTime         @default(now())
}

// --- EXPENSES (separate from Purchase Bills — operating costs like rent, utilities, fuel) ---
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id])
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Expense {
  id            Int             @id @default(autoincrement())
  // Nullable then filled right after create (same pattern as Order.invoiceNumber) — multiple
  // NULLs coexist fine under a unique constraint, avoiding a placeholder-value collision race.
  expenseNumber String?         @unique
  categoryId    Int
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  payeeName     String
  description   String?
  amount        Float
  status        ExpenseStatus   @default(DRAFT)

  // Tags the debit (expense) leg posted at approve() time — a pure reporting dimension.
  costCenterId Int?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  paidAt     DateTime?
}

model JournalEntry {
  id         Int               @id @default(autoincrement())
  date       DateTime          @default(now())
  memo       String?
  sourceType JournalSourceType @default(MANUAL)
  sourceId   Int?
  lines      JournalLine[]
  createdAt  DateTime          @default(now())

  // Which Journal (Cash/Bank/Sales/Purchase/Misc) this entry posted through — nullable so every
  // entry posted before this field existed stays valid with no data loss.
  journalId Int?
  journal   Journal? @relation(fields: [journalId], references: [id])

  // Set when this entry has been corrected via a reversal — the entry itself is never mutated/deleted.
  voidedAt     DateTime?
  // If this entry IS a reversal, points back to the entry it reverses.
  reversalOfId Int?          @unique
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("EntryReversal")
}

model JournalLine {
  id          Int     @id @default(autoincrement())
  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?

  // Set only on AR/AP-touching lines (sales/purchase invoices, payments) — powers the Partner Ledger.
  // Nullable so pre-existing journal lines (posted before this field existed) stay valid with no data loss.
  partyType PartyType?
  partyName String?

  // Optional department/project tag — a pure reporting dimension, set by whoever posts the entry
  // (manual journal entry, expense). Auto-posted lines (POS, invoices, payroll, ...) never set this.
  costCenterId Int?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  // Optional outlet/branch dimension for Outlet P&L — set only on revenue/COGS lines auto-posted
  // from a warehouse-scoped sale (POS, Sales Invoice, Delivery COGS/returns). Purchases, payroll,
  // manual entries, and expenses never set this — those lines fall into the report's "Unassigned" bucket.
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId Int
  account   Account @relation(fields: [accountId], references: [id])
}

// --- POS: lightweight walk-in checkout, separate from the Sales Order chain. No terminals/
// registers concept, no split payments — one payment method per sale, PIN attribution only
// (not a login), sessions are simple open/close time markers (no cash-count reconciliation). ---
model PosStaff {
  id             Int                @id @default(autoincrement())
  name           String
  pinHash        String
  isActive       Boolean            @default(true)
  sessionsOpened PosSession[]       @relation("SessionOpenedBy")
  sessionsClosed PosSession[]       @relation("SessionClosedBy")
  sales          PosSale[]
  cancelledSales PosCancelledSale[]
  createdAt      DateTime           @default(now())
}

model PosSession {
  id          Int              @id @default(autoincrement())
  status      PosSessionStatus @default(OPEN)
  warehouseId Int
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])

  openedById Int?
  openedBy   PosStaff? @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedById Int?
  closedBy   PosStaff? @relation("SessionClosedBy", fields: [closedById], references: [id])

  sales PosSale[]

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // Till reconciliation — all optional so existing/simple sessions (no cash count taken) keep
  // working unchanged. expectedCash/cashVariance are server-computed at close time, never
  // client-supplied, so they can't be spoofed to hide a shortfall.
  openingCash  Float?
  expectedCash Float?
  countedCash  Float?
  cashVariance Float?
}

model PosSale {
  id             Int     @id @default(autoincrement())
  invoiceNumber  String? @unique
  totalAmount    Float   @default(0)
  discountAmount Float   @default(0)
  taxId          Int?
  tax            Tax?    @relation(fields: [taxId], references: [id])
  taxAmount      Float   @default(0)
  clientName     String?

  // Optional link to the Customer directory — clientName stays the source of truth for
  // aging/ledger matching, this just remembers which saved customer it came from.
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  sessionId Int
  session   PosSession @relation(fields: [sessionId], references: [id])

  warehouseId Int

  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  servedById Int?
  servedBy   PosStaff? @relation(fields: [servedById], references: [id])

  items PosSaleItem[]
  payments PosSalePayment[]

  // Set when this sale is cancelled — restocks inventory and reverses the GL postings at the
  // same time (unlike the audit-only PosCancelledSale log, which just records that it happened).
  cancelledAt DateTime?

  createdAt DateTime @default(now())
}

model PosSaleItem {
  id          Int    @id @default(autoincrement())
  quantity    Int
  price       Float
  // Snapshot of Product.costPrice at sale time, for COGS posting — insulated from later cost-price edits.
  costPrice   Float
  batchNumber String @default("DEFAULT")

  posSaleId Int
  posSale   PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// Audit-only cancellation log — matches the reference implementation's behavior of never
// auto-reversing stock/GL on cancel, just recording that it happened and why.
model PosCancelledSale {
  id             Int     @id @default(autoincrement())
  originalSaleId Int?
  itemsSummary   Json
  totalAmount    Float
  reason         String?

  cancelledById Int?
  cancelledBy   PosStaff? @relation(fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
}

// --- PAYROLL: Employee HR records are separate from User login accounts (an Employee may
// optionally be linked to one, e.g. a merchandiser who is also on payroll, but most won't be).
// Qatar-specific: GRSIA (retirement/social insurance, Qatari nationals only) and End-of-Service
// gratuity (non-Qatari, vests at 1 year) are the two statutory calculations this module implements.
model Employee {
  id       Int     @id @default(autoincrement())
  name     String
  isQatari Boolean @default(false)

  qidNumber          String?
  qidExpiryDate      DateTime?
  passportNumber     String?
  passportExpiryDate DateTime?
  visaExpiryDate     DateTime?
  bankName           String?
  iban               String?

  basicSalary             Float @default(0)
  housingAllowance        Float @default(0)
  transportationAllowance Float @default(0)
  telephoneAllowance      Float @default(0)
  otherAllowance          Float @default(0)

  payrollActive Boolean  @default(true)
  hireDate      DateTime @default(now())

  // Optional link if this employee also has a dashboard login (e.g. a merchandiser).
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  payslips       Payslip[]
  loans          EmployeeLoan[]
  eosAccrualLogs EosAccrualLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-row settings table (always id=1) — GRSIA %, working hours, overtime multipliers, EOS formula input.
model PayrollConfig {
  id                      Int   @id @default(autoincrement())
  grsiaEmployeePercent    Float @default(5)
  grsiaEmployerPercent    Float @default(10)
  workingDaysPerMonth     Float @default(26)
  workingHoursPerDay      Float @default(8)
  overtimeMultiplier      Float @default(1.25)
  nightOvertimeMultiplier Float @default(1.5)
  eosWeeksPerYear         Float @default(3)
}

model PayrollRun {
  id          Int              @id @default(autoincrement())
  // Nullable then filled right after create (id-based) — multiple NULLs coexist fine under a
  // unique constraint, avoiding a placeholder-value collision race between concurrent creates.
  runNo       String?          @unique
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)

  totalGross      Float @default(0)
  totalDeductions Float @default(0)
  totalNet        Float @default(0)

  // Set once processed/paid — the two journal entries this run posted.
  journalEntryId        Int?
  paymentJournalEntryId Int?

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id           Int        @id @default(autoincrement())
  payrollRunId Int
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  basicSalary         Float
  allowancesTotal     Float @default(0)
  allowancesBreakdown Json

  overtimeHours      Float @default(0)
  nightOvertimeHours Float @default(0)
  overtimeAmount     Float @default(0)

  unpaidLeaveDays      Float @default(0)
  unpaidLeaveDeduction Float @default(0)

  grossPay Float @default(0)

  // GRSIA only applies to Qatari employees — 0 for everyone else.
  grsiaEmployeeAmount Float @default(0)
  grsiaEmployerAmount Float @default(0)

  loanDeduction   Float @default(0)
  otherDeductions Float @default(0)
  totalDeductions Float @default(0)
  netPay          Float @default(0)

  // Snapshot at generation time — insulated from a later change to Employee.isQatari.
  isQatari Boolean

  loanRepayments EmployeeLoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeLoan {
  id     Int     @id @default(autoincrement())
  // Nullable then filled right after create — same race-avoidance pattern as PayrollRun.runNo.
  loanNo String? @unique

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  principalAmount    Float
  monthlyDeduction   Float
  outstandingBalance Float
  status             EmployeeLoanStatus @default(ACTIVE)
  journalEntryId     Int?

  repayments EmployeeLoanRepayment[]

  dateIssued DateTime @default(now())
}

model EmployeeLoanRepayment {
  id             Int          @id @default(autoincrement())
  employeeLoanId Int
  employeeLoan   EmployeeLoan @relation(fields: [employeeLoanId], references: [id], onDelete: Cascade)

  // Null means a manual repayment, not tied to a specific payroll run.
  payslipId Int?
  payslip   Payslip? @relation(fields: [payslipId], references: [id])

  amount    Float
  createdAt DateTime @default(now())
}

// Single-row settings table — created lazily with defaults on first read/write (same pattern as
// PayrollConfig). Feeds the letterhead (logo + company info) on every printed document/report, and
// the Report Designer's global styling knobs. Per-report column visibility lives in reportFieldsJson
// keyed by report type (e.g. { trialBalance: ["code","name",...] }) so adding a new toggle never
// needs a migration.
model CompanySettings {
  id                 Int     @id @default(autoincrement())
  name               String  @default("")
  address            String?
  phone              String?
  email              String?
  website            String?
  taxNumber          String?
  logoUrl            String?
  footerNote         String?
  termsAndConditions String?

  reportShowLogo    Boolean @default(true)
  reportShowAddress Boolean @default(true)
  reportShowPhone   Boolean @default(true)
  reportShowEmail   Boolean @default(true)
  reportShowWebsite Boolean @default(true)
  reportShowFooter  Boolean @default(false)

  reportHeaderColor String @default("E0E0E0")
  reportAccentColor String @default("0D9488")
  reportOrientation String @default("portrait")
  reportDensity     String @default("normal")
  reportBorderStyle String @default("bordered")
  reportFieldsJson  Json   @default("{}")

  // POS checkout defaults — plain scalar IDs, not FK relations, since a stale reference (the
  // default warehouse/payment method later gets deleted) should just fail to preselect on the
  // checkout screen, not block deleting that warehouse/payment method or require a migration.
  posDefaultWarehouseId     Int?
  posDefaultPaymentMethodId Int?
  posRequireCustomer        Boolean @default(false)
  posReceiptFooter          String?
  posAutoPrintReceipt       Boolean @default(false)
  posMaxDiscountPercent     Float?
  posRequireCashCount       Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// The "App Store" — first-party modules ship in this same codebase (see src/app-modules/module-catalog.ts
// for the catalog) but stay dormant until installed here. One row per module `key`; `config` holds
// whatever that module's settings form collects (API keys, toggles) as free-form JSON since each
// module's shape is different and none of it is queried relationally.
model InstalledModule {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  isActive    Boolean   @default(false)
  config      Json?
  installedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// Live-computed EOS accrual is never stored as a balance — this is an incremental ledger so
// each monthly post only books the delta since the last one (diffed against the live formula).
model EosAccrualLog {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  amountPosted   Float
  journalEntryId Int?
  createdAt      DateTime @default(now())
}

